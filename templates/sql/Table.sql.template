CREATE TABLE [SCHEMA].[ENTIDADES]
(
    [ID_ENTIDAD]                    BIGINT IDENTITY(1,1) NOT NULL,
    [CODIGO]                        NVARCHAR(50) NOT NULL,
    [NOMBRE]                        NVARCHAR(200) NOT NULL,
    [DESCRIPCION]                   NVARCHAR(500) NULL,
    [CODIGO_ESTADO]                 NVARCHAR(30) NOT NULL
        CONSTRAINT [DF_ENTIDADES_CODIGO_ESTADO] DEFAULT (N'ACTIVO'),
    [FECHA_ALTA_UTC]                DATETIME2(3) NOT NULL
        CONSTRAINT [DF_ENTIDADES_FECHA_ALTA_UTC] DEFAULT (SYSUTCDATETIME()),
    [ID_USUARIO_ALTA]               BIGINT NOT NULL,
    [FECHA_MODIFICACION_UTC]        DATETIME2(3) NULL,
    [ID_USUARIO_MODIFICACION]       BIGINT NULL,
    [ROW_VERSION]                   ROWVERSION NOT NULL,
    CONSTRAINT [PK_ENTIDADES] PRIMARY KEY CLUSTERED ([ID_ENTIDAD])
);
