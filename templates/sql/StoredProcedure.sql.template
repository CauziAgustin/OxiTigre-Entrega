CREATE OR ALTER PROCEDURE [SCHEMA].[SP_ENTIDAD_ACCION]
    @I_PARAMETRO       BIGINT,
    @S_ID_SESION       BIGINT,
    @O_CODIGO_ERROR    BIGINT OUTPUT,
    @O_MENSAJE         NVARCHAR(4000) OUTPUT,
    @O_FILAS_AFECTADAS INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    -- INICIO: Inicialización de parámetros de salida.
    SET @O_CODIGO_ERROR = NULL;
    SET @O_MENSAJE = NULL;
    SET @O_FILAS_AFECTADAS = 0;
    -- FIN: Inicialización de parámetros de salida.

    -- INICIO: Validación de parámetros de entrada.
    IF @I_PARAMETRO IS NULL
    BEGIN
        THROW 50000, 'El parámetro de entrada es obligatorio.', 1;
    END; -- FIN: Validación de parámetros de entrada.

    BEGIN TRY
        -- INICIO: Operación funcional principal.
        -- Implementar la operación con objetos calificados por schema.
        SET @O_FILAS_AFECTADAS = @@ROWCOUNT;
        -- FIN: Operación funcional principal.
    END TRY
    BEGIN CATCH
        -- INICIO: Propagación controlada del error.
        SET @O_CODIGO_ERROR = COALESCE(@O_CODIGO_ERROR, CONVERT(BIGINT, 70002));
        SET @O_MENSAJE = ERROR_MESSAGE();
        THROW;
        -- FIN: Propagación controlada del error.
    END CATCH;
END;
